# Cloudflare Pages Custom HTTP Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Linux Shell Script (curl / wget execution)
/setup.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

# Search Engine Crawlers & Sitemaps
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Open Graph & Social Sharing Banners
/og-image.svg
  Content-Type: image/svg+xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/og-image.png
  Content-Type: image/png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Favicon & Progressive Web App Manifest
/favicon.svg
  Content-Type: image/svg+xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, immutable

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# Static compiled assets (Immutable cache for max performance)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Global Web Application Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
