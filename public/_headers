# Cloudflare Pages Custom HTTP Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Linux Shell Script (curl / wget execution)
/setup.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

# Static compiled assets (Immutable cache for max performance)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Open Graph & Social Sharing Vector Banner
/og-image.svg
  Content-Type: image/svg+xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Global Web Application Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
